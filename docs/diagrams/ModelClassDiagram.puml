@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ClientIdentityRegistry {
- nextClientId : long
}
Class ClientId <<immutable>> {
- value : int
}
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class FollowUp {
- dueDate : LocalDate
- description : String
+ getStatus(today : LocalDate) : FollowUpStatus
}
enum FollowUpStatus <<enumeration>> {
OVERDUE
DUE_TODAY
UPCOMING
}
note bottom of FollowUp
Immutable value: private final fields.
Status uses dueDate and supplied today;
no stored status or device-clock access.
end note
Class Address
Class Email
Class Name
Class Phone
Class Tag

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model
HiddenOutside -[hidden]left-> ReadOnlyUserPrefs

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
AddressBook *--> "1" ClientIdentityRegistry
ClientIdentityRegistry --> "*" ClientId : assigns
ClientIdentityRegistry --> "*" Person : canonical references
UniquePersonList --> "*" Person
Person --> "1" Name
Person --> "1" Phone
Person --> "1" Email
Person --> "1" Address
Person --> "*" Tag
Person --> "0..1" FollowUp
FollowUp ..> FollowUpStatus : derives status

' Show only the identity and follow-up details needed by this diagram.
show ClientIdentityRegistry fields
show ClientId fields
show FollowUp fields
show FollowUp methods
show FollowUpStatus fields

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email
Phone -[hidden]down-> FollowUp

@enduml
