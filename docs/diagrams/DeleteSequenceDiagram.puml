@startuml
!include style.puml
skinparam ParticipantPadding 8
participant ":LogicManager" as logic LOGIC_COLOR
participant "command:\nDeleteCommand" as command LOGIC_COLOR
participant "live:Model" as live MODEL_COLOR
participant "candidate:\nModel" as candidate MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR
[-> logic : execute("delete 1")
note over logic : Parse command; sample today
logic -> live : forkForCommand(today)
live --> logic : candidate
logic -> command : execute(candidate)
command -> candidate : getAddressBook()
candidate --> command : addressBook
note over command
Resolve Client ID 1 against
all clients, including hidden ones.
end note
command -> candidate : deletePerson(person)
command --> logic : result
logic -> candidate : hasUnsavedChanges()
candidate --> logic : true
logic -> storage : saveAddressBook(...)
alt Save succeeds
    storage --> logic
    logic -> live : commitFrom(candidate)
    [<-- logic : result
else Save fails
    storage --> logic : IOException
    [<-- logic : CommandException
end
@enduml
