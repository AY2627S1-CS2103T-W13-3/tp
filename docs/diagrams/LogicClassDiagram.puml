@startuml
!include style.puml
!pragma layout smetana
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF

package Logic as LogicPackage {
    interface Logic <<interface>> {
        + execute(commandText: String): CommandResult
        + getFilteredPersonList(): ObservableList<Person>
        + getAllPersonList(): ObservableList<Person>
    }
    class LogicManager
    package "Parser Classes" as ParserClasses {
        class AddressBookParser
    }
    abstract class Command
    class XYZCommand
    class CommandResult
}

package Model as ModelPackage {
    interface Model <<interface>>
}

package Storage as StoragePackage {
    interface Storage <<interface>>
}

' Shared style hides members; expose only the selected Logic API above.
show Logic methods

LogicManager .up.|> Logic
LogicManager -down-> "1" AddressBookParser
ParserClasses ..> XYZCommand : <<create>>

XYZCommand -up-|> Command
LogicManager .down.> Command : <<call>>

LogicManager -down-> "1" Model
LogicManager -down-> "1" Storage
Command .down.> Model : <<call>>
Model -[hidden]right-> Storage

Logic ..> CommandResult
LogicManager ..> CommandResult
Command ..> CommandResult : <<create>>

note top of Logic
    getAllPersonList(): full committed clients in insertion order.
    getFilteredPersonList(): filtered / pending-ordered display list.
    Both are stable, unmodifiable views.
    Commands resolve permanent Client IDs globally, not row positions.
end note

note as PublicationNote
    LogicManager executes against an isolated Model candidate.
    Saves dirty data before commitFrom publishes it.
    Identity is retained; selection is reconciled by Client ID.
    A failed save does not publish the candidate.
end note
XYZCommand -[hidden]down-> PublicationNote

note as CommandExamples
    XYZ is a placeholder for routed commands, e.g.
    AddCommand, ViewCommand, SetFollowUpCommand,
    ClearFollowUpCommand, EditCommand and FollowUpsCommand.
end note
PublicationNote -[hidden]down-> CommandExamples
@enduml
