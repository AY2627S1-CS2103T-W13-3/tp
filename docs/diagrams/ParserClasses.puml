@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam nodesep 25
skinparam ranksep 35

title Parsing follow-up and view commands

Class AddressBookParser
Interface Parser <<interface>>
Class FollowUpCommandParser
Class ViewCommandParser
Class FollowUpParserUtil
Class ParserUtil
Class ArgumentTokenizer
Class ArgumentMultimap
Class CliSyntax
Class Prefix

abstract class Command
Class SetFollowUpCommand
Class ClearFollowUpCommand
Class ViewCommand
Class FollowUpsCommand

' Keep the returned commands on one row, above the routing parsers.
ClearFollowUpCommand -[hidden]right-> SetFollowUpCommand
SetFollowUpCommand -[hidden]right-> FollowUpsCommand
FollowUpsCommand -[hidden]right-> ViewCommand

' Only these two classes implement Parser; T extends Command.
AddressBookParser .down.> FollowUpCommandParser : <<create>>\nfollowup: parse(args)
AddressBookParser .down.> ViewCommandParser : <<create>>\nview: parse(args)
FollowUpCommandParser .right.|> Parser : <Command>
ViewCommandParser .left.|> Parser : <ViewCommand>

FollowUpCommandParser .up.> SetFollowUpCommand : <<create>>\nset / replace
FollowUpCommandParser .up.> ClearFollowUpCommand : <<create>>\nclear
ViewCommandParser .up.> ViewCommand : <<create>>
AddressBookParser .up.> FollowUpsCommand : <<create>>\nfollowups (direct)
SetFollowUpCommand -up-|> Command
ClearFollowUpCommand -up-|> Command
ViewCommand -up-|> Command
FollowUpsCommand -up-|> Command

FollowUpCommandParser .down.> FollowUpParserUtil : parseIndex()
FollowUpParserUtil .down.> ParserUtil : parseIndex()
ViewCommandParser .down.> ParserUtil : parseIndex()
FollowUpCommandParser .down.> ArgumentTokenizer : tokenize()
FollowUpCommandParser .down.> ArgumentMultimap : reads / checks\nduplicates
ArgumentTokenizer .down.> ArgumentMultimap : <<create>>
FollowUpCommandParser .down.> CliSyntax : d/, m/
CliSyntax .down.> Prefix : <<create>>
ArgumentTokenizer .down.> Prefix

note left of AddressBookParser
  parseCommand checks raw characters,
  trims spaces, checks empty input
  and splits command / arguments.
  Failed-load gate blocks add, delete,
  followup before argument parsing.
  view and followups still route.
end note

' Set form checks shape, duplicate prefixes, then index syntax; values stay raw.
' Clear form requires no d/ or m/ and checks index syntax.
@enduml
