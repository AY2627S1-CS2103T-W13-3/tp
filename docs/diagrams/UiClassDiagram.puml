@startuml
!pragma layout smetana
!include style.puml
left to right direction
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
abstract class UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class ClientProfilePanel
Class PersonListPanel
Class PendingFollowUpPanel
Class PendingFollowUpProjection
Class StatusBarFooter
Class CommandBox
}

package Model <<Rectangle>> {
Class Person MODEL_COLOR
}

package "Logic" as LogicPackage <<Rectangle>> {
interface "Logic" as LogicApi <<interface>> LOGIC_COLOR
}


UiManager ..|> Ui
UiManager --> "1" MainWindow
MainWindow *-->  "1" CommandBox
MainWindow *--> "1" ResultDisplay
MainWindow *--> "1" PersonListPanel
MainWindow *--> "1" StatusBarFooter
MainWindow *--> "1" ClientProfilePanel
MainWindow --> "1" HelpWindow

MainWindow *--> "1" PendingFollowUpPanel
MainWindow *--> "1" PendingFollowUpProjection

MainWindow --|> UiPart

ResultDisplay --|> UiPart
CommandBox --|> UiPart
PersonListPanel --|> UiPart
PendingFollowUpPanel --|> UiPart
ClientProfilePanel --|> UiPart
StatusBarFooter --|> UiPart
HelpWindow --|> UiPart

PersonListPanel ..> Person
PendingFollowUpProjection ..> Person
PendingFollowUpPanel ..> Person
ClientProfilePanel ..> Person
UiManager --> LogicApi
MainWindow --> LogicApi

@enduml
