@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class ClientProfilePanel {
  -clientIdLookup : Function
  -renderedClientId : Optional<ClientId>
}
Class PersonListPanel {
  -personTable : TableView<Person>
  -clientIdLookup : Function
  -today : ReadOnlyObjectProperty<LocalDate>
  -showingFollowUps : ReadOnlyBooleanProperty
  -selectedPerson : ReadOnlyObjectProperty<Person>
}
Class PendingFollowUpPanel {
  -clientIdLookup : Function
}
Class PendingFollowUpProjection
Class StatusBarFooter
Class CommandBox
}

' Show the ID presentation state without exposing unrelated UI implementation details.
' Must follow the class declaration, or PlantUML reports a syntax error.
show PersonListPanel fields
show ClientProfilePanel fields
show PendingFollowUpPanel fields

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
interface "Logic" as LogicApi {
  +getClientId(Person) : Optional<ClientId>
}
show LogicApi methods
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow *--> "1" ClientProfilePanel
MainWindow --> "1" HelpWindow

MainWindow *--> "1" PendingFollowUpPanel
MainWindow *--> "1" PendingFollowUpProjection

MainWindow -left-|> UiPart

ResultDisplay --|> UiPart
CommandBox --|> UiPart
PersonListPanel --|> UiPart
PendingFollowUpPanel --|> UiPart
ClientProfilePanel --|> UiPart
StatusBarFooter --|> UiPart
HelpWindow --|> UiPart

PersonListPanel ..> Model
PendingFollowUpProjection ..> Model
PendingFollowUpPanel ..> Model
ClientProfilePanel ..> Model
UiManager -right-> Logic
MainWindow -left-> LogicApi : ID lookup

PersonListPanel -[hidden]left- HelpWindow
HelpWindow -[hidden]left- CommandBox
CommandBox -[hidden]left- ResultDisplay
ResultDisplay -[hidden]left- StatusBarFooter

MainWindow -[hidden]-|> UiPart
@enduml
