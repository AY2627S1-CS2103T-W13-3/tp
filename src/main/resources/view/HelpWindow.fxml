<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root minWidth="360" minHeight="200" title="PolicyHarbor Help" type="javafx.stage.Stage"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox fx:id="helpMessageContainer" styleClass="help-window" spacing="8" prefWidth="560">
        <padding>
          <Insets top="16" right="16" bottom="16" left="16" />
        </padding>
        <Label styleClass="help-title" text="PolicyHarbor Help" />
        <Label styleClass="help-text" wrapText="true" minHeight="-Infinity"
               text="The user guide explains every command, with examples. Open this link in your browser:" />
        <HBox spacing="8" alignment="CENTER_LEFT">
          <!-- Read-only field: the full link can be selected and scrolled even when the window is narrow. -->
          <TextField fx:id="userGuideUrl" editable="false" styleClass="help-url" HBox.hgrow="ALWAYS"
                     accessibleText="User guide link" />
          <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy link"
                  defaultButton="true" minWidth="-Infinity" />
        </HBox>
        <Label fx:id="copyStatus" styleClass="help-status" wrapText="true" minHeight="-Infinity" />
        <Label styleClass="help-hint" text="Press Esc to close this window." />
      </VBox>
    </Scene>
  </scene>
</fx:root>
