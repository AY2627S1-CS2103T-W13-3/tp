<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="client-table-panel" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <stylesheets>
    <URL value="@ClientTable.css" />
  </stylesheets>
  <!-- Preserve model ordering; the ID column fits the full positive 32-bit range. -->
  <TableView fx:id="personTable" styleClass="client-table" VBox.vgrow="ALWAYS">
    <columnResizePolicy>
      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
    <columns>
      <TableColumn fx:id="clientIdColumn" text="Client ID" sortable="false" minWidth="110" prefWidth="110" maxWidth="110"
                   resizable="false" styleClass="client-id-column" />
      <TableColumn fx:id="nameColumn" text="Name" sortable="false" minWidth="80" prefWidth="160" />
      <TableColumn fx:id="phoneColumn" text="Phone" sortable="false" minWidth="70" prefWidth="100" />
      <TableColumn fx:id="emailColumn" text="Email" sortable="false" minWidth="80" prefWidth="180" />
      <TableColumn fx:id="dueColumn" text="Due" sortable="false" minWidth="86" prefWidth="96" />
      <TableColumn fx:id="statusColumn" text="Status" sortable="false" minWidth="86" prefWidth="96" />
    </columns>
  </TableView>
</VBox>
