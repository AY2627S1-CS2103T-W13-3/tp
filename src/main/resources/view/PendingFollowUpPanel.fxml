<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="pending-follow-up-panel"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <stylesheets>
    <URL value="@PendingFollowUpPanel.css" />
  </stylesheets>
  <content>
    <VBox spacing="16" fillWidth="true" styleClass="pending-panel-content">
      <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
      </padding>
      <Label styleClass="pending-panel-title" text="PENDING FOLLOW-UPS" wrapText="true" />
      <Label styleClass="pending-panel-note" text="Summary of all clients · use the numbered table for commands"
             wrapText="true" maxWidth="Infinity" />
      <Label fx:id="emptyMessage" styleClass="pending-empty" text="No pending follow-ups." wrapText="true" />
      <VBox fx:id="overdueGroup" spacing="8">
        <Label styleClass="pending-group-overdue" text="OVERDUE" />
        <VBox fx:id="overdueCards" spacing="8" fillWidth="true" />
      </VBox>
      <VBox fx:id="dueTodayGroup" spacing="8">
        <Label styleClass="pending-group-due-today" text="DUE TODAY" />
        <VBox fx:id="dueTodayCards" spacing="8" fillWidth="true" />
      </VBox>
      <VBox fx:id="upcomingGroup" spacing="8">
        <Label styleClass="pending-group-upcoming" text="UPCOMING" />
        <VBox fx:id="upcomingCards" spacing="8" fillWidth="true" />
      </VBox>
    </VBox>
  </content>
</ScrollPane>
