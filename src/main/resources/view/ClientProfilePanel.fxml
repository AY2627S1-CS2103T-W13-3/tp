<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="client-profile-panel"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <stylesheets>
    <URL value="@ClientProfilePanel.css" />
  </stylesheets>
  <content>
    <VBox spacing="16" fillWidth="true" styleClass="profile-card">
      <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
      </padding>
      <Label styleClass="profile-eyebrow" text="CLIENT PROFILE" />
      <Label fx:id="noSelectionMessage" styleClass="profile-empty" text="No client selected." wrapText="true" />
      <VBox fx:id="profileDetails" spacing="18" fillWidth="true">
        <Label fx:id="name" styleClass="profile-name" wrapText="true" maxWidth="Infinity" />
        <VBox spacing="12" styleClass="profile-section">
          <Label styleClass="profile-section-title" text="CONTACT" />
          <VBox spacing="2">
            <Label styleClass="profile-field-label" text="PHONE" />
            <Label fx:id="phone" styleClass="profile-field-value" wrapText="true" maxWidth="Infinity" />
          </VBox>
          <VBox spacing="2">
            <Label styleClass="profile-field-label" text="EMAIL" />
            <Label fx:id="email" styleClass="profile-field-value" wrapText="true" maxWidth="Infinity" />
          </VBox>
          <VBox spacing="2">
            <Label styleClass="profile-field-label" text="ADDRESS" />
            <Label fx:id="address" styleClass="profile-field-value" wrapText="true" maxWidth="Infinity" />
          </VBox>
        </VBox>
        <VBox spacing="8" styleClass="profile-section">
          <Label styleClass="profile-section-title" text="TAGS" />
          <Label fx:id="tagsNone" styleClass="profile-muted" text="No tags" />
          <FlowPane fx:id="tagChips" hgap="6" vgap="6" minWidth="0" />
        </VBox>
        <VBox spacing="10" styleClass="profile-section">
          <Label styleClass="profile-section-title" text="NEXT FOLLOW-UP" />
          <Label fx:id="followUpNone" styleClass="profile-muted" text="Follow-up: None" wrapText="true" />
          <VBox fx:id="followUpDetails" spacing="10" fillWidth="true">
            <Label fx:id="followUpStatus" styleClass="profile-status" wrapText="true" />
            <VBox spacing="2">
              <Label styleClass="profile-field-label" text="DUE DATE" />
              <Label fx:id="followUpDate" styleClass="profile-field-value" wrapText="true" />
            </VBox>
            <VBox spacing="2">
              <Label styleClass="profile-field-label" text="ACTION" />
              <Label fx:id="followUpAction" styleClass="profile-field-value" wrapText="true" maxWidth="Infinity" />
            </VBox>
          </VBox>
        </VBox>
      </VBox>
    </VBox>
  </content>
</ScrollPane>
